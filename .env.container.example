APP_PORT=8000
LOG_LEVEL=INFO

# watsonx.ai generation and embeddings
# 東京リージョン（jp-tok）のwatsonx.ai Runtime URL。
WATSONX_URL=https://jp-tok.ml.cloud.ibm.com
WATSONX_PROJECT_ID=
WATSONX_API_KEY=
WATSONX_MODEL_ID=
WATSONX_EMBEDDING_MODEL_ID=
# 必須: 選択したwatsonx.ai Embedding modelの出力次元と一致させる。
# Milvus collectionのVector次元とも一致しなければならない。
EMBEDDING_DIMENSION=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=500
LLM_TEMPERATURE=0.1

# IBM Cloud接続モード。Python直接実行でもComposeでも同じ値を使用する。
LLM_PROVIDER=watsonx
EMBEDDING_PROVIDER=watsonx
VECTOR_STORE_PROVIDER=milvus

# watsonx.data Milvus
# IBM Cloud consoleのgRPC host／portから検証済み形式のURIを設定する。
MILVUS_URI=https://your-milvus-host.example.com:443
# API Key方式: ibmlhapikey_<watsonx.data username>
# IAM token方式: ibmlhtoken_<watsonx.data username>
# 旧形式のibmlhapikey／ibmlhtoken単独指定は使用しない。
MILVUS_USERNAME=ibmlhapikey_your-user-name
# API Key方式ではwatsonx.dataをプロビジョニングしたアカウントのIBM Cloud API Key。
# IAM token方式ではIAM access token。実値を配布ZIPやGitへ含めない。
MILVUS_PASSWORD=
MILVUS_DATABASE=default
MILVUS_COLLECTION=helpdesk_knowledge
MILVUS_TLS=true

VECTOR_TOP_K=5
# 調整開始値。正答率や確率ではなく、Embedding modelと評価データごとに調整する。
VECTOR_MIN_SCORE=0.45
