APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# mock | local | watsonx | openai_compatible
LLM_PROVIDER=mock
LLM_MODEL_ID=mock-helpdesk-v1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=500
LLM_TEMPERATURE=0.1

# watsonx.ai: LLM_PROVIDER=watsonx のときのみ設定する
WATSONX_URL=https://jp-tok.ml.cloud.ibm.com
WATSONX_PROJECT_ID=
WATSONX_API_KEY=
WATSONX_MODEL_ID=

# OpenAI 互換 API: LLM_PROVIDER=openai_compatible のときのみ設定する
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL_ID=

# mock | local | watsonx
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL_ID=mock-embedding-v1
EMBEDDING_DIMENSION=64
WATSONX_EMBEDDING_MODEL_ID=

# chroma | numpy | milvus
VECTOR_STORE_PROVIDER=chroma
VECTOR_TOP_K=5
VECTOR_MIN_SCORE=0.45

# ローカルChroma（data/index/chromaへ永続化）
CHROMA_COLLECTION=helpdesk_knowledge

# watsonx.data Milvus: VECTOR_STORE_PROVIDER=milvus のときのみ設定する
MILVUS_URI=
MILVUS_USERNAME=
MILVUS_PASSWORD=
MILVUS_DATABASE=default
MILVUS_COLLECTION=helpdesk_knowledge
MILVUS_TLS=true

SEED_DATA_DIR=./data/seed
# 画面とAPIで使用する初期Ticket
TICKET_SEED_FILE=tickets_app.json
RUNTIME_DATA_DIR=./data/runtime
INDEX_DIR=./data/index
